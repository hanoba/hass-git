[Unit]
Description=GY-511 to MQTT Bridge
After=network.target mosquitto.service

[Service]
ExecStart=/usr/bin/python3 /home/harald/hass-git/scripts/gy511_to_mqtt.py
WorkingDirectory=/home/harald
StandardOutput=null
StandardError=journal
Restart=always
RestartSec=5
User=harald

[Install]
WantedBy=multi-user.target

